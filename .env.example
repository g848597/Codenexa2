ENV=development

# Строка подключения к PostgreSQL (можно временно использовать ту же Supabase,
# что и у CodeNexa — таблицы этого проекта не пересекаются с его схемой,
# см. migrations/001_init.sql). Для локальной разработки/тестов подойдёт
# и localhost-инстанс Postgres.
DATABASE_URL=postgresql://user:password@host:5432/dbname

DB_POOL_MIN=1
DB_POOL_MAX=10

# Токен бота, которому принадлежит Mini App — нужен для проверки подписи initData.
TELEGRAM_BOT_TOKEN=123456:AA...

# Через запятую. "*" допустим только для локальной разработки.
CORS_ORIGINS=*

# Домен для редирект-эндпоинта GET /r/:slug (3.6 URL Shortener). По
# умолчанию совпадает с адресом самого бэкенда — задайте отдельно, если
# сервис висит за собственным доменом (напр. "https://tgtoolkit.app").
SHORT_LINK_BASE_URL=http://127.0.0.1:8001

# --- Этап 5 (Дизайн) — хранилище для PNG/JPG, отрендеренных на клиенте ---
# Оставьте S3_BUCKET пустым для локальной разработки — тогда файлы пишутся
# на диск (LOCAL_MEDIA_DIR) и раздаются самим бэкендом по /media/*.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Только для S3-совместимых хранилищ (MinIO/R2/Yandex Object Storage) —
# для настоящего AWS S3 оставьте пустым.
S3_ENDPOINT_URL=
# Если перед бакетом свой домен/CDN — иначе URL собирается автоматически.
S3_PUBLIC_URL_BASE=

LOCAL_MEDIA_DIR=./media
LOCAL_MEDIA_BASE_URL=http://127.0.0.1:8001/media
